# Copy to .env.local. Everything is optional for local development.

# Database. Leave unset to use the embedded PGlite database in ./.data/pglite (no install).
# For a real Postgres (e.g. `docker compose up -d`):
# DATABASE_URL=postgres://gymfuel:gymfuel@localhost:5432/gymfuel

# Signs the session cookie. Required in production (32+ chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# Set to "false" to stop a brand-new dev database being filled with demo data.
# SEED_DEMO_DATA=true

# AI. Without a key, GymFuel uses a built-in demo generator so every flow still works.
# OPENAI_API_KEY=
# OPENAI_MEAL_ANALYSIS_MODEL=gpt-5.6-terra
# OPENAI_RECIPE_MODEL=gpt-5.6-luna

# Optional: stock photos for new recipes.
# UNSPLASH_ACCESS_KEY=
