# --- REQUIRED ---
domain_name = "yourdomain.com"

# --- OPTIONAL ---
project_name = "ecs-gymfuel"
environment  = "dev"
aws_region   = "eu-west-2"

# Database
db_name           = "gymfuel_db"
db_username       = "gymfuel"
db_instance_class = "db.t3.micro"

# Resources
ecs_cpu    = "256"
ecs_memory = "512"

# GymFuel Lens (create this secret manually; do not put the API key in tfvars)
openai_api_key_secret_arn = ""
openai_meal_analysis_model = "gpt-5.6-terra"
openai_recipe_model        = "gpt-5.6-luna"
